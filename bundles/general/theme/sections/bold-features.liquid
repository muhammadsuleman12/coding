{% render 'bold-typography' %}
{% render 'heading-scale-override', section: section %}
{% liquid
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign accent_word = section.settings.accent_word
  assign subheading = section.settings.subheading
  assign feature_blocks = section.blocks | where: 'type', 'feature'
%}

<div class="forge-section-background bold-bg forge-color-{{ section.settings.color_scheme }}"></div>
<section class="bold-features bold-section forge-section forge-section--full-width forge-color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bold-features__inner">
    <div class="bold-section-header" data-animate="fade-up">
      {% if label != blank %}
        <span class="bold-section-label">{{ label }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2 class="bold-section-title">
          {% assign words = heading | split: ' ' %}
          {% for word in words %}
            {% if accent_word != blank and word == accent_word %}
              <span class="bold-accent">{{ word }}</span>
            {% else %}
              {{ word }}
            {% endif %}
            {% unless forloop.last %} {% endunless %}
          {% endfor %}
        </h2>
      {% endif %}
      {% if subheading != blank %}
        <p class="bold-section-subtitle">{{ subheading }}</p>
      {% endif %}
      <div class="bold-accent-line"></div>
    </div>

    {% if feature_blocks.size > 0 %}
      <div class="bold-features__grid" data-animate-group>
        {% for block in feature_blocks limit: 4 %}
          <div class="bold-features__card" data-animate="fade-up" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <span class="bold-features__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="bold-features__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="bold-features__desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bold-features {
    padding: calc(72px * var(--section-spacing-scale, 1)) 24px;
    position: relative;
  }

  .bold-features__inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .bold-features__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--style-gap-cards, 20px);
  }

  .bold-features__card {
    background: var(--bold-card-bg);
    border: 1px solid var(--bold-glass-border);
    border-radius: var(--bold-radius-lg);
    padding: 32px 24px;
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .bold-features__card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--bold-accent2) 30%, transparent);
  }

  .bold-features__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 18px;
    border-radius: var(--style-border-radius-global, 14px);
    background: color-mix(in srgb, var(--bold-accent2) 12%, transparent);
    font-size: 1.6rem;
    line-height: 1;
  }

  .bold-features__title {
    font-family: var(--bold-font-heading);
    font-size: 0.95rem;
    font-weight: var(--font-h3--weight, 700);
    text-transform: var(--font-h3--case, uppercase);
    letter-spacing: var(--font-h3--letter-spacing, 0.5px);
    color: var(--bold-text-light);
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .bold-features__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--bold-text-faint);
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .bold-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .bold-features {
      padding: calc(48px * var(--section-spacing-scale, 1)) 16px;
    }

    .bold-features__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bold Features",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:forge.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "heading_scale_override",
      "label": "Heading size override",
      "default": "default",
      "options": [
        { "value": "default", "label": "Use theme setting" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra large" }
      ],
      "info": "Overrides the theme's global Heading size setting for this section only."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Why Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the Wild"
    },
    {
      "type": "text",
      "id": "accent_word",
      "label": "Accent word",
      "default": "Wild"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every product is engineered to perform when it matters most."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🏔️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "All-Weather Durability"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Tested in extreme conditions and everyday use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bold Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "🏔️", "title": "All-Weather Durability", "description": "Tested in extreme conditions and everyday use." } },
        { "type": "feature", "settings": { "icon": "🎒", "title": "Ultralight Design", "description": "Lightweight design that doesn't slow you down." } },
        { "type": "feature", "settings": { "icon": "♻️", "title": "Sustainable Materials", "description": "Recycled fabrics and responsible manufacturing at every step." } },
        { "type": "feature", "settings": { "icon": "🛡️", "title": "Lifetime Warranty", "description": "We stand behind every product with our no-questions guarantee." } }
      ]
    }
  ]
}
{% endschema %}
