<section class="pl-section pl-picked" style="--pl-pt:{{ section.settings.pt }}px;--pl-pb:{{ section.settings.pb }}px;">
  <div class="pl-wrap">
    <div class="pl-head">
      <div>
        <h2 class="pl-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="pl-text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="pl-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}{% render 'pl-icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="pl-grid">
      {%- for product in section.settings.products -%}
        <div class="pl-grid__item">
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product, product_view_context: 'collection' %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pet picked products",
  "tag": "div",
  "class": "pl-picked-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pet favourites"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Pet picked products"
    }
  ]
}
{% endschema %}
