

{% assign button_collection = closest.collection %}
{% assign button_url = button_collection.url %}

{% if button_collection.products_count > section.settings.max_products %}
  {% render 'button', link: button_url %}
{% endif %}

{% schema %}
{
  "name": "t:forge.names.product_list_button",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:forge.content.visible_if_collection_has_more_products"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:forge.settings.label",
      "default": "t:forge.text_defaults.button_label"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:forge.settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:forge.settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:forge.options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:forge.options.secondary"
        },
        {
          "value": "link",
          "label": "t:forge.options.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:forge.content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:forge.settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:forge.options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:forge.options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:forge.settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:forge.settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:forge.options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:forge.options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:forge.settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:forge.names.product_list_button",
      "category": "t:forge.categories.collection",
      "settings": {
        "label": "t:forge.text_defaults.view_all_button_label",
        "style_class": "button-secondary"
      }
    }
  ]
}
{% endschema %}
