

<div
  class="password-enter forge-color-{{ section.settings.color_scheme }}"
  data-testid="password-footer"
>
  <p class="password-enter__powered-by">
    {% render 'forge-t', key: 'content.powered_by', fallback: 'This shop will be powered by' %}
    <a
      href="//shopify.com"
      rel="nofollow"
      target="_blank"
      aria-label="Shopify"
      aria-describedby="a11y-new-window-message"
    >
      {{- 'icon-shopify.svg' | inline_asset_content -}}
    </a>
  </p>
  <div class="password-enter__links">
    <button
      class="forge-button-unstyled password-enter__button"
      on:click="#password-form/showDialog"
    >
      {% render 'forge-t', key: 'actions.enter_using_password', fallback: 'Enter using password' %}
    </button>
    <p class="password-enter__admin-link">
      {{ 'content.store_owner_link_html' | t: link: '/admin' }}
    </p>
  </div>
  <ul hidden>
    <li id="a11y-new-window-message">{% render 'forge-t', key: 'accessibility.new_window', fallback: 'Opens in a new window.' %}</li>
  </ul>
</div>

{% schema %}
{
  "name": "t:forge.names.footer_password",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:forge.settings.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
