{%- if section.blocks.size > 0 -%}
<section class="pl-section" style="--pl-pt:{{ section.settings.pt }}px;--pl-pb:{{ section.settings.pb }}px;">
  <div class="pl-wrap">
    <div class="pl-head"><div class="pl-revhead"><h2 class="pl-h2">{{ section.settings.heading }}</h2>{%- if section.settings.label != blank -%}<span class="pl-pill">{{ section.settings.label }}</span>{%- endif -%}</div></div>
    <div class="pl-reviews__grid">
      {%- for block in section.blocks -%}
        <figure class="pl-review" {{ block.shopify_attributes }}>
          <span class="pl-stars" role="img" aria-label="{{ block.settings.rating }} out of 5">
            {%- for i in (1..5) -%}<span class="{% if i > block.settings.rating %}is-off{% endif %}">{% render 'pl-icon', name: 'star', size: 18 %}</span>{%- endfor -%}
          </span>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption class="pl-review__who"><span class="pl-avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span><span>{{ block.settings.name }}{% if block.settings.detail != blank %}<small>{{ block.settings.detail }}</small>{% endif %}</span></figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Pet customer reviews",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by pet parents"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label next to heading",
      "default": "Sample reviews",
      "info": "Shown on the store. Clear it once you replace the sample reviews with real customer reviews."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail (e.g. product or pet)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet customer reviews"
    }
  ],
  "enabled_on": {
    "templates": [
      "index",
      "product",
      "collection",
      "page"
    ]
  }
}
{% endschema %}
