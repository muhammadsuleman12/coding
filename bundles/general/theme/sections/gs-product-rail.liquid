<section class="gs-section gs-rail forge-color-{{ section.settings.color_scheme }}">
  <div class="gs-wrap">
    <div class="gs-head gs-head--row">
      <div>
        <h2 class="gs-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="gs-sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if section.blocks.size == 1 and section.settings.link_label != blank -%}
        <a class="gs-textlink" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} {% render 'gs-icon', name: 'arrow', size: 16 %}</a>
      {%- endif -%}
      {%- if section.blocks.size > 1 -%}
        <div class="gs-tabs" role="tablist" data-gs-tabs aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            {%- assign label = block.settings.label | default: block.settings.collection.title | default: 'Collection' -%}
            <button type="button" role="tab" class="gs-tab" id="GsTab-{{ block.id }}" aria-controls="GsPanel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>{{ label | escape }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection | default: collections.all
        assign tag = block.settings.tag
        assign more_url = col.url
        if block.settings.collection == blank and tag != blank
          assign more_url = routes.all_products_collection_url | append: '/' | append: tag
        endif
        assign list = col.products
        if block.settings.collection == blank and block.settings.newest
          assign list = collections.all.products | sort: 'created_at' | reverse
        endif
        assign shown = 0
      -%}
      <div class="gs-rail__panel" id="GsPanel-{{ block.id }}" {% if section.blocks.size > 1 %}role="tabpanel" aria-labelledby="GsTab-{{ block.id }}"{% endif %} {% unless forloop.first %}hidden{% endunless %}>
        <ul class="gs-grid gs-grid--scroll" role="list" style="--cols: {{ section.settings.columns }}">
          {%- for product in list -%}
            {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
            {%- if block.settings.collection == blank and tag != blank -%}
              {%- unless product.tags contains tag -%}{%- continue -%}{%- endunless -%}
            {%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <li>{% render 'gs-product-card', product: product %}</li>
          {%- endfor -%}
          {%- if shown == 0 -%}<li class="gs-rail__empty">No products to show here yet.</li>{%- endif -%}
        </ul>
        {%- if section.blocks.size > 1 -%}<div class="gs-rail__more"><a class="gs-link" href="{{ more_url }}">View all {{ block.settings.label | default: col.title | escape }}</a></div>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>


{% schema %}
{
  "name": "Product row with tabs",
  "tag": "div",
  "class": "gs-shell",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular right now" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label (single tab only)", "default": "Shop all products" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 16, "step": 1, "default": 8 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "tag", "label": "Or product tag", "info": "Used when no collection is picked." },
        { "type": "checkbox", "id": "newest", "label": "Newest products first (when no collection)", "default": false },
        { "type": "text", "id": "label", "label": "Tab label" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Product row with tabs", "blocks": [ { "type": "tab" }, { "type": "tab" } ] }]
}
{% endschema %}
