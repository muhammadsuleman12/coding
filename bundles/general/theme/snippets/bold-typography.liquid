{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;600;700;800;900&display=swap');

  .bold-section {
    --bold-primary: var(--color-background);
    --bold-accent1: var(--color-primary);
    --bold-accent2: var(--color-gradient-2, var(--color-primary-hover));
    --bold-accent3: var(--color-background-secondary);
    --bold-text-light: var(--color-foreground);
    --bold-text-dark: var(--color-foreground-heading);
    --bold-text-muted: var(--color-foreground-muted);
    --bold-text-subtle: rgb(var(--color-foreground-rgb) / var(--opacity-35-55));
    --bold-text-faint: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
    --bold-success: #22c55e;
    --bold-glass: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    --bold-glass-border: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
    --bold-card-bg: var(--color-card-background);
    --bold-gradient2: linear-gradient(
      135deg,
      var(--color-gradient-1, var(--color-primary)),
      var(--color-gradient-2, var(--color-primary-hover))
    );
    --bold-radius: var(--style-border-radius-global, 12px);
    --bold-radius-lg: calc(var(--style-border-radius-global, 12px) * 1.5);
    --bold-shadow: var(--style-shadow-card, 0 8px 32px rgb(var(--color-shadow-rgb) / 0.3));
    --bold-shadow-lg: var(--style-shadow-card, 0 16px 48px rgb(var(--color-shadow-rgb) / 0.4));
    --bold-font-heading: var(--font-heading--family, 'Montserrat', system-ui, sans-serif);
    --bold-font-body: var(--font-body--family, 'Inter', system-ui, sans-serif);
    font-family: var(--bold-font-body);
    color: var(--bold-text-light);
  }

  .shopify-section:not(.header-section) .forge-section-background.bold-bg {
    background: var(--color-background);
  }
  .shopify-section:not(.header-section) .forge-section-background.bold-bg--surface {
    background:
      radial-gradient(
        ellipse 60% 50% at 80% 20%,
        color-mix(in srgb, var(--color-gradient-2, var(--color-primary)) 12%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 50% 40% at 10% 80%,
        color-mix(in srgb, var(--color-primary) 10%, transparent) 0%,
        transparent 70%
      ),
      var(--color-background);
  }
  .shopify-section:not(.header-section) .forge-section-background.bold-bg--strip {
    background: var(--color-card-background);
    border-block: 1px solid var(--color-border);
  }

  .bold-section-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .bold-section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--bold-accent2);
    margin-bottom: 12px;
    font-family: var(--bold-font-heading);
  }

  .bold-section-title {
    font-family: var(--bold-font-heading);
    font-weight: var(--font-h2--weight, 800);
    font-size: clamp(1.8rem, 4vw, calc(var(--font-h2--size) * 1.15));
    text-transform: var(--font-h2--case, uppercase);
    letter-spacing: var(--font-h2--letter-spacing, -0.5px);
    line-height: 1.15;
    margin-bottom: 12px;
    color: var(--bold-text-light);
  }

  .bold-section-title .bold-accent {
    color: var(--bold-accent2);
  }

  .bold-section-subtitle {
    color: var(--bold-text-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .bold-accent-line {
    width: 60px;
    height: 3px;
    background: var(--bold-gradient2);
    border-radius: var(--style-border-radius-pills);
    margin: 14px auto 0;
  }

  .bold-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: var(--bold-font-body);
    box-shadow: 0 4px 20px rgb(var(--color-primary-rgb) / 0.35);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .bold-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgb(var(--color-primary-rgb) / 0.5);
  }

  .bold-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--style-border-radius-buttons-secondary);
    background: transparent;
    color: var(--bold-text-light);
    border: 1px solid var(--bold-glass-border);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .bold-btn-secondary:hover {
    border-color: var(--bold-accent2);
    color: var(--bold-accent2);
  }

  body.bold-high-conversion .sticky-atc--active .forge-sticky-atc-container,
  body.bold-high-conversion .sticky-atc--active .sticky-atc-container--restructured {
    background: color-mix(in srgb, var(--color-card-background) 92%, transparent) !important;
    backdrop-filter: blur(20px);
    border-radius: 0;
    border: none;
    box-shadow: 0 -8px 32px rgb(var(--color-shadow-rgb) / 0.35);
  }

  body.bold-high-conversion .sticky-atc--active .sticky-atc__btn,
  body.bold-high-conversion .sticky-atc--active button[name="add"] {
    background: var(--color-primary-button-background) !important;
    color: var(--color-primary-button-text) !important;
    border-radius: var(--style-border-radius-buttons-primary) !important;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 20px rgb(var(--color-primary-rgb) / 0.35);
  }

  body.bold-high-conversion .sticky-atc--active .forge-sticky-atc__price,
  body.bold-high-conversion .sticky-atc--active .forge-sticky-atc__title {
    color: var(--color-foreground) !important;
  }
{% endstyle %}
