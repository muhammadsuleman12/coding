

{%- doc -%}
  Display an image of a collection inside a collection card.
  Intended for collection-card.liquid block.

  @param {string} parent_block_id - The block.id of the collection-card block

  @example
  {% content_for 'block', type: '_collection-card-image', id: 'collection-card-image', parent_block_id: block.id %}
{%- enddoc -%}

{% liquid
  assign collection = closest.collection
  assign image_source = collection.image
  if image_source == blank
    assign image_source = collection.products.first.featured_image
  endif
%}

{% render 'resource-image',
  content_type: 'collections',
  image_source: image_source,
  parent_block_id: parent_block_id,
  block_settings: block.settings,
  section_settings: section.settings,
  block_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:forge.names.collection_card_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:forge.content.resource_reference_collection_card_image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:forge.settings.aspect_ratio",
      "info": "t:forge.info.aspect_ratio_adjusted",
      "options": [
        {
          "value": "adapt",
          "label": "t:forge.options.auto"
        },
        {
          "value": "portrait",
          "label": "t:forge.options.portrait"
        },
        {
          "value": "square",
          "label": "t:forge.options.square"
        },
        {
          "value": "landscape",
          "label": "t:forge.options.landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:forge.settings.media_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:forge.settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:forge.settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:forge.options.solid"
        },
        {
          "value": "gradient",
          "label": "t:forge.options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:forge.settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:forge.options.up"
        },
        {
          "value": "to bottom",
          "label": "t:forge.options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:forge.content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:forge.settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:forge.options.none"
        },
        {
          "value": "solid",
          "label": "t:forge.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:forge.settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:forge.settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:forge.settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
