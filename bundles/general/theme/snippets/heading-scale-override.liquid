{%- liquid
  assign override = section.settings.heading_scale_override
  assign multiplier = blank
  if override == 'small'
    assign multiplier = 0.85
  elsif override == 'medium'
    assign multiplier = 1
  elsif override == 'large'
    assign multiplier = 1.15
  elsif override == 'xlarge'
    assign multiplier = 1.3
  endif
-%}
{%- if multiplier != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      --heading-scale: {{ multiplier }};
    }
  {% endstyle %}
{%- endif -%}
