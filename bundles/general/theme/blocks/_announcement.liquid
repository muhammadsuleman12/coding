

{%- assign block_settings = block.settings -%}
{%- assign plain_text = block_settings.text | strip_newlines | strip_html | strip -%}
{%- assign block_index = section.blocks | find_index: 'id', block.id -%}

{%- unless plain_text == '' -%}
  <forge-slideshow-slide
    ref="slides[]"
    class="
      announcement-bar__slide
      forge-text-block
      text-block--{{ block.id }}
      text-block--align-center
      text-block--full-width
      forge-custom-typography
      {% if block_settings.font_size != "" %}custom-font-size{% endif %}
      {% if block_settings.weight != "" %}custom-font-weight{% endif %}
    "
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      --width: 100%;
      --text-align: center;
      --line-height: 1;
    "
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    {% if section.settings.enable_scrolling_text %}
      <div class="announcement-bar__marquee">
        <div class="announcement-bar__marquee-track">
          <p class="announcement-bar__text announcement-bar__marquee-text">
            {{ block.settings.text }}
          </p>
        </div>
      </div>
    {% else %}
      <p class="announcement-bar__text">
        {{ block.settings.text }}
      </p>
    {% endif %}

    {% if block_settings.link != blank %}
      <a
        class="announcement-bar__link"
        href="{{ block_settings.link }}"
      >
        <span class="forge-visually-hidden">
          {{ block_settings.text | strip_html }}
        </span>
      </a>
    {% endif %}
  </forge-slideshow-slide>
{%- endunless -%}

{% stylesheet %}
  .forge-text-block {
    width: var(--width);
    max-width: 100%;
  }

  .forge-text-block > * {
    width: var(--width);
    max-width: var(--max-width, 100%);
    text-align: var(--text-align);
  }

  .forge-text-block:not(.text-block--full-width).forge-rte,
  .forge-text-block:not(.text-block--full-width).forge-paragraph {
    /* Safari doesn't support pretty, so fallback to balance */
    text-wrap: balance;
    text-wrap: pretty;
  }

  .forge-text-block:not(.text-block--full-width).h1,
  .forge-text-block:not(.text-block--full-width).forge-h2,
  .forge-text-block:not(.text-block--full-width).forge-h3,
  .forge-text-block:not(.text-block--full-width).forge-h4,
  .forge-text-block:not(.text-block--full-width).forge-h5,
  .forge-text-block:not(.text-block--full-width).forge-h6 {
    text-wrap: balance;
  }

  /* Hide underline unless text is using paragraph styles. */
  .forge-text-block:is(.h1, .forge-h2, .forge-h3, .forge-h4, .forge-h5, .forge-h6) a {
    text-decoration-color: transparent;
  }

  .forge-text-block h1,
  .forge-text-block.h1 > * {
    margin-block: var(--font-h1--spacing);
  }

  .forge-text-block h2,
  .forge-text-block.forge-h2 > * {
    margin-block: var(--font-h2--spacing);
  }

  .forge-text-block h3,
  .forge-text-block.forge-h3 > * {
    margin-block: var(--font-h3--spacing);
  }

  .forge-text-block h4,
  .forge-text-block.forge-h4 > * {
    margin-block: var(--font-h4--spacing);
  }

  .forge-text-block h5,
  .forge-text-block.forge-h5 > * {
    margin-block: var(--font-h5--spacing);
  }

  .forge-text-block h6,
  .forge-text-block.forge-h6 > * {
    margin-block: var(--font-h6--spacing);
  }

  .forge-text-block > *:first-child {
    margin-block-start: 0;
  }

  .forge-text-block > *:last-child {
    margin-block-end: 0;
  }

  .text-block--align-center,
  .text-block--align-center > * {
    margin-inline: auto;
  }

  .text-block--align-right,
  .text-block--align-right > * {
    margin-inline-start: auto;
  }
{% endstylesheet %}

