          "id": "image",
          "label": "Image (4:5)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "dog",
          "options": [
            {
              "value": "paw",
              "label": "Paw"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "mail",
              "label": "Mail"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "bone",
              "label": "Bone"
            },
            {
              "value": "bowl",
              "label": "Bowl"
            },
            {
              "value": "bed",
              "label": "Bed"
            },
            {
              "value": "leash",
              "label": "Leash"
            },
            {
              "value": "brush",
              "label": "Brush"
            },
            {
              "value": "cat",
              "label": "Cat"
            },
            {
              "value": "dog",
              "label": "Dog"
            },
            {
              "value": "bird",
              "label": "Bird"
            },
            {
              "value": "shirt",
              "label": "Shirt"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "tag",
              "label": "Tag"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "For the dogs"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button label",
          "default": "Shop dogs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#f7dcc6"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet promo cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
