<section class="gs-section gs-section--tight gs-news forge-color-{{ section.settings.color_scheme }}">
  <div class="gs-wrap">
    <div class="gs-news__card">
            <div class="gs-news__copy">
        <h2 class="gs-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="gs-sub">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- assign form_id = 'GsNews-' | append: section.id -%}
      {%- form 'customer', id: form_id, class: 'gs-news__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="gs-news__msg" role="status">{{ section.settings.success }}</p>
        {%- else -%}
          <label class="gs-sr" for="GsNewsEmail-{{ section.id }}">Email</label>
          <input id="GsNewsEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="Your email address">
          <button type="submit" class="gs-btn gs-btn--auto">{{ section.settings.button_label | escape }}</button>
          {%- if form.errors -%}<p class="gs-news__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "class": "gs-shell",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good finds, straight to your inbox" },
    { "type": "text", "id": "text", "label": "Text", "default": "New arrivals and price drops, once a week. No spam." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You're on the list. Watch your inbox for the next drop." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
