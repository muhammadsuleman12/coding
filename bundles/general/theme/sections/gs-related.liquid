{%- liquid
  assign limit = section.settings.limit
  assign url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: limit | append: '&intent=' | append: section.settings.intent
-%}
<section class="gs-section gs-related forge-color-{{ section.settings.color_scheme }}" {% unless recommendations.performed and recommendations.products_count > 0 %}hidden{% endunless %}>
  <div class="gs-wrap">
    <div class="gs-head gs-head--row"><h2 class="gs-title">{{ section.settings.heading | escape }}</h2><a class="gs-textlink" href="{{ routes.all_products_collection_url }}">Shop all products {% render 'gs-icon', name: 'arrow', size: 16 %}</a></div>
    <div data-gs-related data-url="{{ url }}">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <ul class="gs-grid gs-grid--scroll" role="list" style="--cols: 4">
          {%- for p in recommendations.products -%}<li>{% render 'gs-product-card', product: p %}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "class": "gs-shell",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "select", "id": "intent", "label": "Type", "default": "related", "options": [ { "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary" } ] },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
