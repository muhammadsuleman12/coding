<section class="pl-section pl-story pl-story--{{ section.settings.media_side }} pl-story--{{ section.settings.style }}{% if section.settings.full %} pl-story--full{% endif %}" style="--pl-pt:{{ section.settings.pt }}px;--pl-pb:{{ section.settings.pb }}px;">
  <div class="pl-wrap">
    <div class="pl-story__card">
      <div class="pl-story__media">
        {%- if section.settings.image != blank -%}
          {%- assign im = section.settings.image -%}
          {%- if section.settings.image_mobile != blank -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
              {{ im | image_url: width: 1400 | image_tag: class: 'pl-media', loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 750px) 55vw, 100vw', alt: im.alt }}
            </picture>
          {%- else -%}
            {{ im | image_url: width: 1400 | image_tag: class: 'pl-media', loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 750px) 55vw, 100vw', alt: im.alt }}
          {%- endif -%}
        {%- else -%}<div class="pl-placeholder" style="position:absolute;inset:0">{% render 'pl-icon', name: 'paw' %}</div>{%- endif -%}
      </div>
      <div class="pl-story__body">
        <span class="pl-story__paws" aria-hidden="true">{% render 'pl-icon', name: 'paw' %}{% render 'pl-icon', name: 'paw' %}{% render 'pl-icon', name: 'paw' %}</span>
        <h2 class="pl-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="pl-text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}
          <a class="pl-btn {% if section.settings.style == 'navy' %}pl-btn--light{% else %}pl-btn--primary{% endif %}" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }}{% render 'pl-icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pet image banner",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop, 4:3)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile, optional, 4:3)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rest well, play hard."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Soft beds for long naps, sturdy toys for the zoomies and gear that makes walks easier \u2014 everything here is picked for real everyday use.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Shop all essentials"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Color style",
      "default": "mint",
      "options": [
        {
          "value": "mint",
          "label": "Mint"
        },
        {
          "value": "navy",
          "label": "Navy"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Image side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Pet image banner"
    }
  ]
}
{% endschema %}
