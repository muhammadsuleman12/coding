
{% liquid
  assign heading = section.settings.heading | strip_html | strip
  assign subheading = section.settings.subheading | strip_html | strip
  assign logo_size = section.settings.logo_size | default: 120
  assign logo_spacing = section.settings.logo_spacing | default: 80
  assign grayscale = section.settings.grayscale
  assign alignment = section.settings.alignment | default: 'center'
%}

<div class="forge-section-background forge-color-{{ section.settings.color_scheme }}"></div>
<section
  class="affluence-logo-wall forge-spacing-style forge-color-{{ section.settings.color_scheme }} affluence-logo-wall--align-{{ alignment }}{% if grayscale %} affluence-logo-wall--grayscale{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %} --alw-size: {{ logo_size }}px; --alw-gap: {{ logo_spacing }}px;"
  {{ section.shopify_attributes }}
>
  {% if heading != blank or subheading != blank %}
    <header class="affluence-logo-wall__header" data-animate="fade-up">
      {% if heading != blank %}
        <p class="affluence-logo-wall__heading">{{ heading }}</p>
      {% endif %}
      {% if subheading != blank %}
        <p class="affluence-logo-wall__subheading">{{ subheading }}</p>
      {% endif %}
    </header>
  {% endif %}

  <ul class="affluence-logo-wall__row" role="list" data-animate-group>
    {% for block in section.blocks %}
      {% liquid
        assign logo_title = block.settings.title | strip_html | strip
        assign has_link = false
        if block.settings.link != blank
          assign has_link = true
        endif
      %}
      <li class="affluence-logo-wall__item" data-animate="fade-up" {{ block.shopify_attributes }}>
        {% if has_link %}<a class="affluence-logo-wall__link" href="{{ block.settings.link }}" aria-label="{{ logo_title | escape }}">{% endif %}
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag:
                class: 'affluence-logo-wall__img',
                loading: 'lazy',
                widths: '120, 240, 360, 400',
                sizes: 'var(--alw-size, 120px)',
                alt: logo_title
            }}
          {% else %}
            <span class="affluence-logo-wall__wordmark">{{ logo_title | default: 'Brand' }}</span>
          {% endif %}
        {% if has_link %}</a>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

{% stylesheet %}
  .affluence-logo-wall {
    width: 100%;
    box-sizing: border-box;
    padding-inline: clamp(20px, 5vw, 56px);
  }

  .affluence-logo-wall__header {
    max-width: 640px;
    margin: 0 auto 32px;
  }

  .affluence-logo-wall--align-center .affluence-logo-wall__header {
    text-align: center;
  }
  .affluence-logo-wall--align-left .affluence-logo-wall__header {
    text-align: left;
    margin-left: 0;
  }

  .affluence-logo-wall__heading {
    margin: 0 0 6px;
    font-family: var(--font-accent--family, inherit);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .affluence-logo-wall__subheading {
    margin: 0;
    font-family: var(--font-body--family, inherit);
    font-weight: var(--font-body--weight, 300);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .affluence-logo-wall__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--alw-gap, 80px) var(--alw-gap, 80px);
    max-width: 1280px;
    margin-inline: auto;
  }

  .affluence-logo-wall--align-left .affluence-logo-wall__row {
    justify-content: flex-start;
  }

  .affluence-logo-wall__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    width: var(--alw-size, 120px);
  }

  .affluence-logo-wall__link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  .affluence-logo-wall__img {
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: 64px;
    display: block;
    object-fit: contain;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }

  .affluence-logo-wall--grayscale .affluence-logo-wall__img {
    filter: grayscale(1);
    opacity: 0.7;
  }

  .affluence-logo-wall--grayscale .affluence-logo-wall__img:hover {
    filter: grayscale(0);
    opacity: 1;
  }

  .affluence-logo-wall__wordmark {
    font-family: var(--font-heading--family, inherit);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .affluence-logo-wall__row {
      gap: 36px;
    }
    .affluence-logo-wall__item {
      width: calc(var(--alw-size, 120px) * 0.85);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Affluence Logo Wall",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo width",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Logo spacing",
      "min": 20,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Render in grayscale",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Brand name",
          "info": "Used as alt text and as a wordmark fallback when no image is uploaded."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Affluence Logo Wall",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
