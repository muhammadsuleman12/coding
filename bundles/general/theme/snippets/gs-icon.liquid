      <path class="gs-icon__line" d="M8 11h12a7 7 0 0 1 0 14h-9M12 6 7 11l5 5"/>
    {%- when 'shield' -%}
      <path class="gs-icon__fill" d="M16 5l10 4v7c0 6-4 10-10 12-6-2-10-6-10-12V9z"/>
      <path class="gs-icon__line" d="M16 3l11 4v8c0 7-5 12-11 14C10 27 5 22 5 15V7zM11 16l4 4 7-8"/>
