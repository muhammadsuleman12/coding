{% render 'bold-typography' %}
{% liquid
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign use_case_blocks = section.blocks | where: 'type', 'use_case'
%}

<div class="forge-section-background bold-bg forge-color-{{ section.settings.color_scheme }}"></div>
<section class="bold-use-cases bold-section forge-section forge-section--full-width forge-color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bold-use-cases__inner">
    {% if label != blank or heading != blank or subtitle != blank %}
      <header class="bold-section-header" data-animate="fade-up">
        {% if label != blank %}
          <span class="bold-section-label">{{ label }}</span>
        {% endif %}
        {% if heading != blank %}
          <h2 class="bold-section-title">{{ heading }}</h2>
        {% endif %}
        {% if subtitle != blank %}
          <p class="bold-section-subtitle">{{ subtitle }}</p>
        {% endif %}
        <div class="bold-accent-line" aria-hidden="true"></div>
      </header>
    {% endif %}

    {% if use_case_blocks.size > 0 %}
      <div class="bold-use-cases__grid" data-animate-group>
        {% for block in use_case_blocks %}
          <article class="bold-use-cases__card" data-animate="fade-up" {{ block.shopify_attributes }}>
            <span class="bold-use-cases__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'mountain' %}
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 21l4-12 4 12M3 21h18M6 14l3-6 3 4 3-5 3 7"/></svg>
                {% when 'tent' %}
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21L12 3l9 18H3z"/><path d="M12 21V9"/></svg>
                {% when 'compass' %}
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M16 8l-2.5 7.5L8 16l2.5-7.5L16 8z"/></svg>
                {% when 'backpack' %}
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12v12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="M6 14h12"/></svg>
                {% when 'water' %}
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69z"/></svg>
                {% when 'fire' %}
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8.5 14.5A3.5 3.5 0 0 0 12 18a3.5 3.5 0 0 0 3.5-3.5c0-2-2-3.5-3.5-5.5-1.5 2-3.5 3.5-3.5 5.5z"/><path d="M12 22c4-2 7-6 7-11a7 7 0 1 0-14 0c0 5 3 9 7 11z"/></svg>
                {% else %}
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/></svg>
              {% endcase %}
            </span>
            {% if block.settings.title != blank %}
              <h3 class="bold-use-cases__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="bold-use-cases__description">{{ block.settings.description }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bold-use-cases {
    padding: 72px 24px;
  }

  .bold-use-cases__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .bold-use-cases__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--style-gap-cards, 20px);
  }

  .bold-use-cases__card {
    background: var(--bold-card-bg);
    border: 1px solid var(--bold-glass-border);
    border-radius: var(--bold-radius-lg);
    padding: 28px 24px;
    text-align: center;
    transition: border-color 0.3s, transform 0.3s;
  }

  .bold-use-cases__card:hover {
    border-color: var(--bold-accent2);
    transform: translateY(-2px);
  }

  .bold-use-cases__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bold-accent2) 12%, transparent);
    color: var(--bold-accent2);
    margin-bottom: 16px;
  }

  .bold-use-cases__title {
    font-family: var(--bold-font-heading);
    font-size: 0.9rem;
    font-weight: var(--font-h3--weight, 700);
    text-transform: var(--font-h3--case, uppercase);
    letter-spacing: var(--font-h3--letter-spacing, normal);
    color: var(--bold-text-light);
    margin: 0 0 8px;
  }

  .bold-use-cases__description {
    font-size: 14px;
    line-height: 1.55;
    color: var(--bold-text-muted);
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .bold-use-cases__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .bold-use-cases {
      padding: 48px 16px;
    }

    .bold-use-cases__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bold Use Cases",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:forge.settings.color_scheme", "default": "scheme-1" },
    { "type": "text", "id": "label", "label": "Section label", "default": "USE CASES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for everyday use" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "From everyday to extreme, this product adapts to any use." }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "Use case",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mountain", "label": "Mountain" },
            { "value": "tent", "label": "Tent" },
            { "value": "compass", "label": "Compass" },
            { "value": "backpack", "label": "Backpack" },
            { "value": "water", "label": "Water" },
            { "value": "fire", "label": "Fire" }
          ],
          "default": "mountain"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Everyday use" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Lightweight and durable for long days of use." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bold Use Cases",
      "blocks": [
        { "type": "use_case", "settings": { "icon": "mountain", "title": "Everyday use" } },
        { "type": "use_case", "settings": { "icon": "tent", "title": "Camping" } },
        { "type": "use_case", "settings": { "icon": "compass", "title": "Navigation" } },
        { "type": "use_case", "settings": { "icon": "backpack", "title": "Day trips" } },
        { "type": "use_case", "settings": { "icon": "water", "title": "Wet conditions" } },
        { "type": "use_case", "settings": { "icon": "fire", "title": "Cold weather" } }
      ]
    }
  ]
}
{% endschema %}
