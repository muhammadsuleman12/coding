
{% assign block_settings = block.settings %}

<forge-accordion-custom
  {% if block_settings.open_by_default %}
    open-by-default-on-desktop
    open-by-default-on-mobile
  {% endif %}
>
  <details
    class="details"
    data-testid="accordion-details"
    {{ block.shopify_attributes }}
  >
    <summary class="details__header">
      {% render 'icon-or-image',
        icon: block_settings.icon,
        svg_icon: block_settings.svg_icon,
        image_upload: block_settings.image_upload,
        width: block_settings.width,
        class_name: 'details__icon'
      %}
      {{ block_settings.heading }}
      <span class="forge-svg-wrapper forge-icon-caret forge-icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="forge-svg-wrapper forge-icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="forge-details-content">
      {% content_for 'blocks' %}
    </div>
  </details>
</forge-accordion-custom>

{% stylesheet %}
  .details__icon {
    height: auto;
    margin-inline-end: var(--margin-xs);
    fill: currentColor;
    stroke: currentColor;
  }
{% endstylesheet %}

