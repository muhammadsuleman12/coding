

{% liquid
  assign block_settings = block.settings
  assign smi_id = block.id | replace: '_', '' | replace: '-', '' | downcase
  assign known_platforms = 'facebook,instagram,youtube,tiktok,twitter,x,threads,linkedin,bluesky,snapchat,pinterest,tumblr,vimeo,spotify,whatsapp,discord,mastodon,reddit,telegram,twitch' | split: ','

  if block_settings.link != blank
    assign platform = block_settings.link | split: '//' | last | remove: 'www.' | split: '.' | first
    assign render_icon = false
    if known_platforms contains platform
      assign render_icon = true
    endif

    assign url_parts = block_settings.link | split: '//' | last | split: '/'
    assign has_profile = false

    if url_parts.size > 1 and url_parts[1] != ''
      assign has_profile = true
    endif

    assign show_label = block_settings.show_label
    unless render_icon
      assign show_label = true
    endunless

    assign label_text = block_settings.label | default: platform | capitalize
  endif
%}

{% if request.design_mode or has_profile %}
  <li
    class="menu__item social-menu__item forge-paragraph social-menu__item-{{ smi_id }}{% unless has_profile %} social-menu__item--disabled{% endunless %}"
    {{ block.shopify_attributes }}
  >
    {% if block_settings.icon_color == 'theme' %}
      {% style %}
      .social-menu__item-{{ smi_id }} .social-menu__icon {
        color: var(--color-primary);
      }
      {% endstyle %}
    {% endif %}

    {% if settings.style_mode == 'gradient' %}
      {%- assign smi_g1 = section.settings.color_scheme.settings.gradient_1 -%}
      {%- assign smi_g2 = section.settings.color_scheme.settings.gradient_2 -%}
      {%- assign smi_g3 = section.settings.color_scheme.settings.gradient_3 -%}
      <svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
        <defs>
          <linearGradient id="smi-icon-grad-{{ smi_id }}" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="{{ smi_g1 }}"/>
            <stop offset="50%" stop-color="{{ smi_g2 }}"/>
            <stop offset="100%" stop-color="{{ smi_g3 }}"/>
          </linearGradient>
        </defs>
      </svg>
      {% style %}
      .social-menu__item-{{ smi_id }} .social-menu__icon {
        fill: url(#smi-icon-grad-{{ smi_id }});
      }
      {% endstyle %}
    {% endif %}

    <a
      href="{{ block_settings.link }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{{ label_text }}"
      {% unless has_profile %}
        {% if request.design_mode %}
          onclick="return false;"
          aria-disabled="true"
        {% endif %}
      {% endunless %}
    >
      {% if render_icon %}
        <svg
          class="social-menu__icon"
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
        >
          {%- render 'icon', icon: platform -%}
        </svg>
      {% endif %}
      {% if show_label %}
        <span class="social-menu__label">{{ label_text }}</span>
      {% endif %}
    </a>
  </li>
{% endif %}

{% stylesheet %}
  .social-menu__item a {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .social-menu__icon {
    display: flex;
    fill: currentColor;
    flex-shrink: 0;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .shopify-design-mode .social-menu__item--disabled {
    opacity: var(--disabled-opacity, 0.5);
    cursor: not-allowed;
  }

  .shopify-design-mode .social-menu__item--disabled a {
    pointer-events: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:forge.names.social_link",
  "tag": null,
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "t:forge.settings.link"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "t:forge.settings.show_label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:forge.settings.label",
      "visible_if": "{{ block.settings.show_label == true }}"
    },
    {
      "type": "select",
      "id": "icon_color",
      "label": "t:forge.settings.icon_color",
      "options": [
        {
          "value": "theme",
          "label": "t:forge.options.theme_color"
        },
        {
          "value": "text",
          "label": "t:forge.options.font_color"
        }
      ],
      "default": "theme"
    }
  ],
  "presets": [
    {
      "name": "t:forge.names.social_link",
      "category": "t:forge.categories.footer"
    }
  ]
}
{% endschema %}
