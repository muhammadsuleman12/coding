    }

    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons button .add-to-cart-text,
    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons button .add-to-cart-text__content,
    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons .forge-add-to-cart-button .add-to-cart-text,
    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons .forge-add-to-cart-button .add-to-cart-text__content {
      font-size: {{ block.settings.desktop_font_size }}px !important;
    }

    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons .forge-quantity-selector button,
    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons .forge-quantity-selector .forge-quantity-minus,
    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons .forge-quantity-selector .forge-quantity-plus,
    .buy-buttons-block--{{ block.id }} .forge-product-form-buttons .forge-quantity-selector .forge-svg-wrapper {
