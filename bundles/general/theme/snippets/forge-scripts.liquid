<script>
  const basePath = 'https://cdn.shopify.com/static/themes/horizon/placeholders';
  window.__themeConfig = {
    placeholders: {
      general: [
        basePath + '/general-1.png',
        basePath + '/general-2.png',
        basePath + '/general-3.png',
        basePath + '/general-4.png',
        basePath + '/general-5.png',
        basePath + '/general-6.png',
        basePath + '/general-7.png',
      ],
      product: [basePath + '/product-ball.png', basePath + '/product-cone.png', basePath + '/product-cube.png'],
    },
    translations: {
      placeholder_image: {{ 'content.placeholder_image' | t | json }},
      added: {{ 'actions.added' | t | json }},
      recipient_form_fields_visible: {{ 'content.recipient_form_fields_visible' | t | json }},
      recipient_form_fields_hidden: {{ 'content.recipient_form_fields_hidden' | t | json }},
      recipient_form_error: {{ 'content.recipient_form_error' | t | json }},
    },
    routes: {
      cart_add_url: {{ routes.cart_add_url | append: '.js' | json }},
      cart_change_url: {{ routes.cart_change_url | json }},
      cart_update_url: {{ routes.cart_update_url | json }},
      cart_url: {{ routes.cart_url | json }},
      predictive_search_url: {{ routes.predictive_search_url | json }},
      search_url: {{ routes.search_url | json }},
    },
    template: {
      name: {{ template | json }},
    },
    designMode: {{ request.design_mode | json }},
  };
  window.Theme = {
    routes: window.__themeConfig.routes,
    translations: window.__themeConfig.translations,
    placeholders: window.__themeConfig.placeholders,
    template: window.__themeConfig.template,
  };
</script>

