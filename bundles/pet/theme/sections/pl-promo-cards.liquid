<section class="pl-section" style="--pl-pt:{{ section.settings.pt }}px;--pl-pb:{{ section.settings.pb }}px;">
  <div class="pl-wrap pl-duo">
    {%- for block in section.blocks -%}
      <div class="pl-duo__card" style="--card-bg: {{ block.settings.bg }}" {{ block.shopify_attributes }}>
        <div class="pl-duo__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: class: 'pl-media', loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, (min-width: 481px) 50vw, 100vw', alt: block.settings.image.alt }}
          {%- else -%}<div class="pl-placeholder" style="position:absolute;inset:0">{% render 'pl-icon', name: block.settings.icon %}</div>{%- endif -%}
        </div>
        <div class="pl-duo__body">
          <span class="pl-icon-badge" style="background:#fff">{% render 'pl-icon', name: block.settings.icon %}</span>
          <h3 class="pl-h3" style="font-size:clamp(1.4rem,2.4vw,1.8rem)">{{ block.settings.heading }}</h3>
          {%- if block.settings.text != blank -%}<p class="pl-text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.btn_label != blank -%}
            <a class="pl-btn pl-btn--primary" href="{{ block.settings.link | default: '/collections/all' }}">{{ block.settings.btn_label }}{% render 'pl-icon', name: 'arrow' %}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Pet promo cards",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "max_blocks": 2,
  "blocks": [
    {
      "type": "card",
      "name": "Promo card",
      "settings": [
        {
