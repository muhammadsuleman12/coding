{%- comment -%}
  Duotone icon set (navy stroke + marigold fill).
  Usage: {% render 'gs-icon', name: 'truck', size: 28 %}
  Names: truck, return, shield, chat, home, kitchen, gift, sparkle, bolt, shirt, sofa, leaf, paw, baby,
         tag, star, heart, clock, check, box, percent, spray, wrench, arrow, plus, minus, search, sun, book, ball
{%- endcomment -%}
{%- liquid
  assign s = size | default: 28
  assign n = name | default: 'tag'
-%}
<svg class="gs-icon gs-icon--{{ n }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  {%- case n -%}
    {%- when 'truck' -%}
      <rect class="gs-icon__fill" x="3" y="9" width="15" height="12" rx="2"/>
