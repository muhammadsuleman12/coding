{%- doc -%}
  Generic line icon set used by the Bold narrative sections.

  @param {string} icon - Icon key. One of: truck, shield-check, star, trophy,
    return-arrow, lock, globe, leaf, recycle, gift, lightning, fire, heart,
    users, sparkle, check-circle, compass, package.
  @param {number} [size] - Pixel width/height. Defaults to 22.
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 22
-%}

<svg
  class="bold-icon"
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'truck' -%}
      <path d="M3 6h11v9H3z" />
      <path d="M14 9h4l3 3v3h-7" />
      <circle cx="7" cy="17" r="2" />
      <circle cx="17" cy="17" r="2" />
    {%- when 'shield-check' -%}
      <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" />
      <path d="M9 12l2 2 4-4" />
    {%- when 'star' -%}
      <path d="M12 3l2.7 5.6 6.3.9-4.5 4.4 1 6.1L12 17.8 6.5 20l1-6.1L3 9.5l6.3-.9z" />
    {%- when 'trophy' -%}
      <path d="M8 21h8" />
      <path d="M12 17v4" />
      <path d="M7 4h10v5a5 5 0 0 1-10 0z" />
      <path d="M7 5H5a2 2 0 0 0-2 2c0 2 1.5 4 4 4" />
      <path d="M17 5h2a2 2 0 0 1 2 2c0 2-1.5 4-4 4" />
    {%- when 'return-arrow' -%}
      <path d="M3 12a9 9 0 1 0 3-6.7" />
      <path d="M3 4v5h5" />
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="9" rx="2" />
      <path d="M8 11V8a4 4 0 0 1 8 0v3" />
      <circle cx="12" cy="15.5" r="1" />
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18" />
      <path d="M12 3a14 14 0 0 1 0 18" />
      <path d="M12 3a14 14 0 0 0 0 18" />
    {%- when 'leaf' -%}
      <path d="M5 19c0-9 6-15 16-15-1 9-6 15-15 15-1 0-1 0-1 0z" />
      <path d="M5 19c2-4 5-7 9-9" />
    {%- when 'recycle' -%}
      <path d="M7 17l-2 3h6" />
      <path d="M5 14l-2-3 3-5 3 1" />
      <path d="M14 5l3 1 3 5-3 1" />
      <path d="M19 13l2 4-4 3-3-3" />
      <path d="M9 9l3-5 3 5" />
    {%- when 'gift' -%}
      <rect x="3" y="9" width="18" height="11" rx="1" />
      <path d="M3 13h18" />
      <path d="M12 9v11" />
      <path d="M12 9c-2 0-4-1-4-3s2-3 4 0c2-3 4-2 4 0s-2 3-4 3z" />
    {%- when 'lightning' -%}
      <path d="M13 2L4 14h7l-1 8 9-12h-7z" />
    {%- when 'fire' -%}
      <path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-3 2-5 2-7 1 1 3 1 3-3z" />
    {%- when 'heart' -%}
      <path d="M12 21s-7-4.5-7-11a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 6.5-7 11-7 11z" />
    {%- when 'users' -%}
      <circle cx="9" cy="9" r="3" />
      <path d="M3 20c0-3 3-5 6-5s6 2 6 5" />
      <circle cx="17" cy="8" r="2.5" />
      <path d="M15 13c4 0 6 2 6 5" />
    {%- when 'sparkle' -%}
      <path d="M12 3v4" />
      <path d="M12 17v4" />
      <path d="M3 12h4" />
      <path d="M17 12h4" />
      <path d="M5.5 5.5l2.5 2.5" />
      <path d="M16 16l2.5 2.5" />
      <path d="M18.5 5.5L16 8" />
      <path d="M8 16l-2.5 2.5" />
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M8 12l3 3 5-6" />
    {%- when 'compass' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M15.5 8.5L13 13l-4.5 2.5L11 11z" />
    {%- when 'package' -%}
      <path d="M3 7l9-4 9 4-9 4z" />
      <path d="M3 7v10l9 4 9-4V7" />
      <path d="M12 11v10" />
    {%- else -%}
      <circle cx="12" cy="12" r="3" />
  {%- endcase -%}
</svg>
