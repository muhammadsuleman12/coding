{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: img
-%}
<section class="gs-hero gs-section forge-color-{{ section.settings.color_scheme }}">
  <div class="gs-wrap gs-hero__grid">
    <div class="gs-hero__copy" data-gs-reveal>
      {%- if section.settings.kicker != blank -%}<p class="gs-hero__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h1 class="gs-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="gs-hero__text">{{ section.settings.text }}</div>{%- endif -%}
      <div class="gs-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="gs-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="gs-btn gs-btn--ghost" href="{{ section.settings.button2_link | default: '#shop-categories' }}">{{ section.settings.button2_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <nav class="gs-hero__links" aria-label="Popular categories">
          <span>Popular:</span>
          {%- for block in section.blocks -%}
            <a href="{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- elsif block.settings.tag != blank -%}{{ routes.all_products_collection_url }}/{{ block.settings.tag | handleize }}{%- else -%}{{ routes.all_products_collection_url }}{%- endif -%}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
    <div class="gs-hero__art">
      <div class="gs-hero__frame gs-unveil" data-gs-reveal>
        {%- if img -%}
          <picture>
            <source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1100 }} 1100w" sizes="100vw">
            {{ img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 55vw, 100vw', class: 'gs-hero__img' }}
          </picture>
        {%- else -%}
          <div class="gs-hero__slot"><span>Hero image<br>1400 × 1100 (mobile 750 × 600)</span></div>
        {%- endif -%}
      </div>
      {%- if section.settings.badge != blank -%}
        <p class="gs-hero__badge">{% render 'gs-icon', name: 'sparkle', size: 22 %}<span>{{ section.settings.badge | escape }}</span></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero: split",
  "tag": "div",
  "class": "gs-shell",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "text", "id": "kicker", "label": "Small line above heading", "default": "New this week" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Everyday essentials, thoughtfully chosen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Home, tech, style, gifts and pet care in one place. Fair prices and tracked delivery on every order.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Browse categories" },
    { "type": "url", "id": "button2_link", "label": "Secondary link" },
    { "type": "text", "id": "badge", "label": "Floating badge on image", "default": "Fresh picks every week" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero image (desktop)", "info": "1400 × 1100 px" },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero image (mobile)", "info": "750 × 600 px. Uses desktop image if empty." }
  ],
  "blocks": [
    { "type": "chip", "name": "Popular link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Electronics" },
      { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "tag", "label": "Or product tag", "info": "Used when no link is set." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Hero: split" }]
}
{% endschema %}
