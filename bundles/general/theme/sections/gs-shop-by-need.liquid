<section class="gs-section gs-needs forge-color-{{ section.settings.color_scheme }}">
  <div class="gs-wrap">
    <div class="gs-head">
      <div>
        <h2 class="gs-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="gs-sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
    </div>
    <ul class="gs-needs__grid" role="list">
      {%- for block in section.blocks -%}
        <li data-gs-reveal {{ block.shopify_attributes }}>
          <a class="gs-need" href="{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- elsif block.settings.tag != blank -%}{{ routes.all_products_collection_url }}/{{ block.settings.tag | handleize }}{%- else -%}{{ routes.all_products_collection_url }}{%- endif -%}">
            <span class="gs-need__icon" aria-hidden="true">{% render 'gs-icon', name: block.settings.icon, size: 34 %}</span>
            <span class="gs-need__label">{{ block.settings.label | escape }}</span>
            {%- if block.settings.note != blank -%}<span class="gs-need__note">{{ block.settings.note | escape }}</span>{%- endif -%}
            <span class="gs-need__go" aria-hidden="true">{% render 'gs-icon', name: 'arrow', size: 18 %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>


{% schema %}
{
  "name": "Shop by need",
  "tag": "div",
  "class": "gs-shell",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What do you need today?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Jump straight to the right aisle." }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Need",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Kitchen helpers" },
        { "type": "text", "id": "note", "label": "Short note", "default": "Tools that save time" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "tag", "label": "Or product tag", "info": "Used when no link is set." },
        { "type": "select", "id": "icon", "label": "Icon", "default": "kitchen", "options": [
          { "value": "home", "label": "Home" }, { "value": "kitchen", "label": "Kitchen" }, { "value": "bolt", "label": "Tech" },
          { "value": "gift", "label": "Gift" }, { "value": "shirt", "label": "Apparel" }, { "value": "sofa", "label": "Furniture" },
          { "value": "leaf", "label": "Outdoor" }, { "value": "paw", "label": "Pets" }, { "value": "baby", "label": "Baby" },
          { "value": "spray", "label": "Cleaning" }, { "value": "wrench", "label": "Tools" }, { "value": "sparkle", "label": "New" },
          { "value": "heart", "label": "Self-care" }, { "value": "book", "label": "Books" }, { "value": "ball", "label": "Sports" },
          { "value": "sun", "label": "Seasonal" }, { "value": "tag", "label": "Deals" }, { "value": "box", "label": "Storage" }
        ] }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Shop by need", "blocks": [ { "type": "need" }, { "type": "need" }, { "type": "need" }, { "type": "need" } ] }]
}
{% endschema %}
