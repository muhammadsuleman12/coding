      <path class="gs-icon__line" d="M4 15 16 5l12 10M7 13v14h18V13M13 27v-8h6v8"/>
    {%- when 'kitchen' -%}
      <rect class="gs-icon__fill" x="7" y="14" width="20" height="12" rx="4"/>
