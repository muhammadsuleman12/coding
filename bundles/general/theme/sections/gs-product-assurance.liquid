{%- assign guide = section.settings.size_guide_page -%}
<section class="gs-section gs-ship forge-color-{{ section.settings.color_scheme }}">
  <div class="gs-wrap">
    <div class="gs-head">
      <h2 class="gs-title">{{ section.settings.heading | escape }}</h2>
      {%- if guide != blank -%}
        {%- assign show_guide = true -%}
        {%- if section.settings.guide_option != blank -%}
          {%- assign show_guide = false -%}
          {%- assign opt_names = product.options | join: '|' | downcase | split: '|' -%}
          {%- assign wanted = section.settings.guide_option | downcase | split: ',' -%}
          {%- for w in wanted -%}{%- assign ww = w | strip -%}{%- if opt_names contains ww -%}{%- assign show_guide = true -%}{%- endif -%}{%- endfor -%}
        {%- endif -%}
        {%- if show_guide -%}
          <button type="button" class="gs-textlink" data-gs-open="GsGuide-{{ section.id }}">{{ section.settings.size_guide_label | escape }} {% render 'gs-icon', name: 'arrow', size: 16 %}</button>
        {%- endif -%}
      {%- endif -%}
    </div>
    <ul class="gs-ship__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="gs-ship__card" href="{{ block.settings.link }}">{%- else -%}<div class="gs-ship__card">{%- endif -%}
            {% render 'gs-icon', name: block.settings.icon, size: 36 %}
            <span><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></span>
            {%- if block.settings.link != blank -%}<span class="gs-ship__go">{% render 'gs-icon', name: 'arrow', size: 18 %}</span>{%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if guide != blank and show_guide -%}
      <dialog class="gs-dialog" id="GsGuide-{{ section.id }}" aria-labelledby="GsGuideTitle-{{ section.id }}">
        <div class="gs-dialog__head">
          <h2 id="GsGuideTitle-{{ section.id }}">{{ guide.title | escape }}</h2>
          <button type="button" class="gs-iconbtn" data-gs-close aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        </div>
        <div class="gs-dialog__body gs-rte">{{ guide.content }}</div>
      </dialog>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shipping & returns",
  "tag": "div",
  "class": "gs-shell",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
    { "type": "header", "content": "Size guide" },
    { "type": "page", "id": "size_guide_page", "label": "Size guide page", "info": "Put the size chart on a page. Leave empty to hide the link." },
    { "type": "text", "id": "size_guide_label", "label": "Link label", "default": "Size guide" },
    { "type": "text", "id": "guide_option", "label": "Only show for products with option", "default": "Size", "info": "Comma separated option names. Leave empty to show on every product." }
  ],
  "blocks": [
    { "type": "item", "name": "Card", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "truck", "label": "Delivery" }, { "value": "box", "label": "Tracking" }, { "value": "refresh", "label": "Returns" },
        { "value": "lock", "label": "Secure" }, { "value": "headset", "label": "Support" }, { "value": "shield", "label": "Protection" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Delivery options" },
      { "type": "text", "id": "text", "label": "Text", "default": "Shipping options and costs are shown at checkout." },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 4,
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Shipping & returns", "blocks": [ { "type": "item" } ] }]
}
{% endschema %}
