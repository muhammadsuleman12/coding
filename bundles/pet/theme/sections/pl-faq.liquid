<section class="pl-section pl-faq" style="--pl-pt:{{ section.settings.pt }}px;--pl-pb:{{ section.settings.pb }}px;">
  <div class="pl-wrap pl-faq__grid">
    <div>
      <h2 class="pl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="pl-text" style="margin-top:12px">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}<p style="margin-top:16px"><a class="pl-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}{% render 'pl-icon', name: 'arrow' %}</a></p>{%- endif -%}
    </div>
    <div class="pl-faq__list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}{% render 'pl-icon', name: 'chevron', size: 20 %}</summary>
          <div class="pl-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pet FAQ",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "q",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I choose the right size?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Check the size chart on the product page and measure your pet before ordering. If they are between sizes, choose the larger one.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet FAQ",
      "blocks": [
        {
          "type": "q"
        }
      ]
    }
  ]
}
{% endschema %}
