<section class="gs-section gs-faq forge-color-{{ section.settings.color_scheme }}">
  <div class="gs-wrap">
    <div class="gs-head gs-head--row">
      <div>
        <h2 class="gs-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="gs-sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.contact_label != blank -%}
        {%- assign contact_url = section.settings.contact_link -%}
        {%- if contact_url == blank -%}{%- assign contact_url = routes.root_url | append: 'pages/contact-us' | replace: '//', '/' -%}{%- endif -%}
        <p class="gs-faq__more">Still have questions? <a href="{{ contact_url }}">{{ section.settings.contact_label | escape }}</a> {% render 'gs-icon', name: 'arrow', size: 16 %}</p>
      {%- endif -%}
    </div>
    <div class="gs-faq__list">
      {%- for block in section.blocks -%}
        <details class="gs-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question | escape }}</span><span class="gs-faq__sign" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
          <div class="gs-faq__answer gs-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
  </script>
</section>


{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "gs-shell",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Contact us" },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "When will my order arrive?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Delivery times and costs are shown at checkout before you pay. You'll get a tracking link by email as soon as your order ships.</p>" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "FAQ", "blocks": [ { "type": "question" }, { "type": "question" }, { "type": "question" } ] }]
}
{% endschema %}
