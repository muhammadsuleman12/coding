{%- doc -%}
  Renders a localization component for the drawer.
  The <forge-drawer-localization> component must be used inside a <forge-header-drawer> component. It relies on event bindings from the parent <forge-header-drawer>  component.

  @param {boolean} [show_country] - Whether to show the country selector
  @param {boolean} [show_language] - Whether to show the language selector
  @param {boolean} [country_style] - Whether to show the country flag
  @param {object} [block] - The block object (optional, used for color scheme and block ID).
  @param {object} [section] - The section object (optional, used for localization font settings).
  @param {object} [settings] - Settings object (optional, used for color schemes).

  @example
  {% render 'drawer-localization', country_style: true %}
{%- enddoc -%}

{% liquid
  if block and block.settings.color_scheme and block.settings.color_scheme.settings.background
    assign background_brightness = block.settings.color_scheme.settings.background | color_brightness
    if background_brightness < 64
      assign flag_shadow_size = 4
    else
      assign flag_shadow_size = 2
    endif
  else
    assign flag_shadow_size = 2
  endif

  if section and section.settings.localization_font
    assign localization_font = '--menu-localization-font: var(--font-[localization_font]--family); ' | replace: '[localization_font]', section.settings.localization_font
  else
    assign localization_font = ''
  endif
  assign color_shadow = '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'
  assign form_style = localization_font | append: color_shadow
  assign localization_block_id = block.id | default: ''
%}

{% if show_language and show_country == false %}
  <div class="menu-drawer__localization forge-color-{{ settings.popover_color_scheme }}">
    {% render 'localization-form',
      show_country: show_country,
      show_language: show_language,
      block_id: localization_block_id,
      form_style: form_style
    %}
  </div>
{% else %}
  <forge-drawer-localization-component class="menu-drawer__localization">
    <details
      id="forge-drawer-localization"
      class="drawer-localization"
      on:toggle="/toggle"
    >
      <summary
        id="HeaderDrawer-localization"
        class="drawer-localization__button forge-h3 forge-link link--text forge-focus-inset"
        aria-expanded="false"
        on:click="forge-header-drawer/open"
        style="{{ form_style }}"
      >
        <div class="drawer-localization__button--label forge-h6">
          {%- if show_country -%}
            <div class="mobile-localization mobile-localization--country forge-link link--text">
              {%- if country_style == true -%}
                <span
                  class="icon-flag"
                  style="
                    background-image: url({{- localization.country | image_url: width: 32 }});
                    --size-shadow: {{ flag_shadow_size }}px;
                    --color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
                  "
                ></span>
              {%- endif -%}
              <span class="currency-code">
                {{- localization.country.currency.iso_code -}}
              </span>
            </div>
          {%- endif -%}

          {%- if show_country and show_language -%}
            <span>/</span>
          {%- endif -%}

          {%- if show_language -%}
            <div class="mobile-localization mobile-localization--country forge-link link--text">
              <span>
                {{ localization.language.iso_code | upcase }}
              </span>
            </div>
          {%- endif -%}
        </div>
        <span class="forge-svg-wrapper forge-icon-caret forge-icon-caret--forward">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </summary>

      <div
        class="menu-drawer__submenu has-submenu gradient motion-reduce forge-color-{{ settings.drawer_color_scheme }}"
        style=""
      >
        <div
          class="menu-drawer__nav-buttons"
          ref="navButtons"
        >
          <button
            class="forge-button menu-drawer__back-button forge-link link--text forge-focus-inset"
            aria-expanded="true"
            on:click="forge-header-drawer/back"
          >
            <span class="forge-svg-wrapper forge-icon-caret forge-icon-caret--backward">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
            {% render 'forge-t', key: 'content.localization_region_and_language', fallback: 'Region and language' %}
          </button>
          <button
            class="forge-button forge-close-button menu-drawer__close-button"
            type="button"
            aria-label="{% render 'forge-t', key: 'actions.close', fallback: 'Close' %}"
            on:click="forge-header-drawer/close"
          >
            <span class="forge-svg-wrapper header-drawer-icon header-drawer-icon--close">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        {% render 'localization-form',
          show_country: show_country,
          show_language: show_language,
          localization_style: 'drawer',
          form_style: form_style,
          block_id: localization_block_id
        %}
      </div>
    </details>
  </forge-drawer-localization-component>
{% endif %}
