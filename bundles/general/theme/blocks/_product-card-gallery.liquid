

{% liquid
  assign has_applied_colour_filter = false
  assign filters_to_check = collection.filters | default: search.filters

  for filter in filters_to_check
    if filter.type == 'list' and filter.param_name contains 'color' and filter.active_values.size > 0
      assign has_applied_colour_filter = true
      break
    endif
  endfor
%}

{% capture children %}
  {% unless closest.product == blank %}
    {% render 'product-card-badges', product: closest.product, settings: settings %}
    {%  if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: closest.product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children, has_applied_colour_filter: has_applied_colour_filter %}

<div class="forge-product-grid-view-zoom-out--details">
  {% if closest.product == blank %}
    <h3 class="forge-h4">{% render 'forge-t', key: 'content.product_card_placeholder', fallback: 'Product title' %}</h3>
  {% else %}
    <h3 class="forge-h4">{{ closest.product.title }}</h3>
    <div class="forge-h6">
      <forge-product-price data-product-id="{{ closest.product.id }}">
        {% render 'price', product_resource: closest.product, show_unit_price: false %}
      </forge-product-price>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:forge.names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:forge.content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:forge.options.auto"
        },
        {
          "value": "portrait",
          "label": "t:forge.options.portrait"
        },
        {
          "value": "square",
          "label": "t:forge.options.square"
        },
        {
          "value": "landscape",
          "label": "t:forge.options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:forge.settings.aspect_ratio",
      "info": "t:forge.info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:forge.content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:forge.settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:forge.options.none"
        },
        {
          "value": "solid",
          "label": "t:forge.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:forge.settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:forge.settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:forge.settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:forge.content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:forge.settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:forge.settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:forge.settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:forge.settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:forge.names.product_card_media",
      "category": "t:forge.categories.product"
    }
  ]
}
{% endschema %}
