<div class="forge-section-background forge-color-{{ section.settings.color_scheme }}"></div>
<section
  class="edna-service-bar forge-spacing-style forge-color-{{ section.settings.color_scheme }}{% if section.settings.show_top_border %} edna-service-bar--top-border{% endif %}{% if section.settings.show_bottom_border %} edna-service-bar--bottom-border{% endif %}{% if section.settings.show_dividers %} edna-service-bar--dividers{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <ul class="edna-service-bar__row" role="list" data-animate-group>
    {% for block in section.blocks %}
      <li class="edna-service-bar__col" data-animate="fade-up" {{ block.shopify_attributes }}>
        <div class="edna-service-bar__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'shipping' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
            {% when 'returns' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 12a8 8 0 1 0 2.5-5.8"/><polyline points="4 4 4 9 9 9"/></svg>
            {% when 'secure' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><polyline points="9 12 11 14 15 10"/></svg>
            {% when 'exchange' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false"><polyline points="16 3 21 3 21 8"/><path d="M21 3l-7 7"/><polyline points="8 21 3 21 3 16"/><path d="M3 21l7-7"/></svg>
            {% when 'gift' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="8" width="18" height="13" rx="0"/><path d="M3 12h18"/><path d="M12 8v13"/><path d="M8.5 8c-1.5 0-2.5-1-2.5-2.3C6 4.3 7.5 3 9 3c1.5 0 3 1.3 3 2.7"/><path d="M15.5 8c1.5 0 2.5-1 2.5-2.3C18 4.3 16.5 3 15 3c-1.5 0-3 1.3-3 2.7"/></svg>
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
          {% endcase %}
        </div>
        <p class="edna-service-bar__heading">{{ block.settings.heading | strip_html | strip }}</p>
        <p class="edna-service-bar__description">{{ block.settings.description | strip_html | strip }}</p>
      </li>
    {% endfor %}
  </ul>
</section>

{% stylesheet %}
  .edna-service-bar {
    width: 100%;
    box-sizing: border-box;
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
  }

  .edna-service-bar--top-border {
    border-block-start: 1px solid var(--color-border);
  }

  .edna-service-bar--bottom-border {
    border-block-end: 1px solid var(--color-border);
  }

  .edna-service-bar__row {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 80rem;
  }

  .edna-service-bar__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    box-sizing: border-box;
    text-align: center;
    min-width: 0;
  }

  .edna-service-bar__col + .edna-service-bar__col {
    border-block-start: 1px solid var(--color-border);
  }

  .edna-service-bar__icon {
    color: var(--color-foreground);
    line-height: 0;
  }

  .edna-service-bar__icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .edna-service-bar__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-weight: var(--font-h4--weight, 500);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-heading, var(--color-foreground));
  }

  .edna-service-bar__description {
    margin: 0;
    font-family: var(--font-body--family, inherit);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);
    max-width: 28ch;
    overflow-wrap: break-word;
  }

  @media screen and (min-width: 750px) {
    .edna-service-bar__row {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }

    .edna-service-bar__col {
      padding: 0.5rem 1.25rem;
      position: relative;
    }

    .edna-service-bar__col + .edna-service-bar__col {
      border-block-start: none;
    }

    .edna-service-bar--dividers .edna-service-bar__col + .edna-service-bar__col::before {
      content: "";
      position: absolute;
      inset-inline-start: 0;
      inset-block-start: 0.75rem;
      inset-block-end: 0.75rem;
      width: 1px;
      background: var(--color-border);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Edna Service Bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top hairline",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom hairline",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show column dividers",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:forge.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure" },
            { "value": "service", "label": "Service" },
            { "value": "exchange", "label": "Exchange" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Complimentary delivery on qualifying orders."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Edna Service Bar",
      "blocks": [
        {
          "type": "service_item",
          "settings": {
            "icon": "shipping",
            "heading": "Free Shipping",
            "description": "Complimentary delivery on every order over the threshold."
          }
        },
        {
          "type": "service_item",
          "settings": {
            "icon": "returns",
            "heading": "Easy Returns",
            "description": "30-day returns on unused items, no questions asked."
          }
        },
        {
          "type": "service_item",
          "settings": {
            "icon": "secure",
            "heading": "Secure Checkout",
            "description": "Encrypted payments and buyer protection on every order."
          }
        }
      ]
    }
  ]
}
{% endschema %}
