

<div class="forge-section-background no-gradient-bg forge-color-{{ section.settings.color_scheme }}"></div>
<div class="forge-section forge-page-width-content forge-color-{{ section.settings.color_scheme }}">
  <div
    class="
      forge-spacing-style
      forge-layout-panel-flex
      forge-layout-panel-flex--column
      forge-section-content-wrapper
      forge-mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:forge.names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:forge.settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:forge.options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:forge.settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:forge.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:forge.content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:forge.settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:forge.settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
